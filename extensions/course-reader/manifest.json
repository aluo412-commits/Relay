{
  "manifest_version": 3,
  "name": "Relay Course Reader — Pilot",
  "version": "0.3.0",
  "description": "Automatic selective course reading: important instructions, reference descriptions, source evidence. No assignment answers or submissions.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["https://relay.aaronluo.com/*"],
  "optional_host_permissions": ["http://localhost:3002/*", "https://fuhsd.schoology.com/*", "https://docs.google.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Read this course page", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "minimum_chrome_version": "120"
}
