// Relay — data model for the AI-first prototype.
// One shared team + project. Each member has a private AI workspace (Message log);
// the board (Task / Update / Knowledge) is shared "Project Memory".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person's login. Global identity, independent of any workspace. A User has one
// Member row per workspace they belong to.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String? // null for accounts that only sign in with Google
  googleId     String?  @unique // Google's stable subject id, when linked
  image        String? // avatar URL from Google
  createdAt    DateTime @default(now())

  members Member[]
}

// The team / workspace. Holds many Boards (Kanbans), shared team memory, and members.
model Project {
  id         String   @id @default(cuid())
  name       String
  deadline   String?
  model      String   @default("glm-5.3-flash") // selected model for the agent (OpenAI-compatible id; default provider is Zhipu GLM)
  inviteCode String   @unique // teammates join this workspace with this code
  createdAt  DateTime @default(now())

  boards        Board[]
  members       Member[]
  tasks         Task[]
  updates       Update[]
  knowledge     Knowledge[]
  messages      Message[]
  logEntries    LogEntry[]
  notifications Notification[]
  sourceFiles   SourceFile[]
  sourceFolders SourceFolder[]
  conversations Conversation[]
}

// A folder in the workspace's source-of-truth tree. Self-referential so folders
// nest; deleting a folder cascades to its subfolders and files.
model SourceFolder {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    SourceFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  SourceFolder[] @relation("FolderTree")
  name      String
  createdAt DateTime       @default(now())

  files SourceFile[]

  @@index([projectId])
}

// An uploaded reference file — the workspace's "source of truth". Bytes live in the
// DB (works locally and on serverless). For text-like files we also store extracted
// text so the agent can treat it as authoritative context.
model SourceFile {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId     String? // null = workspace root
  folder       SourceFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploaderId   String? // Member id (not FK'd, so files survive a member removal)
  uploaderName String?
  name         String
  mimeType     String
  size         Int
  content      Bytes // the raw file
  text         String? // extracted text for text-like files (fed to the agent)
  description  String? // optional one-line "what this is"
  createdAt    DateTime @default(now())

  @@index([projectId])
}

// A single Kanban board within a team.
// A Workstream: a Board elevated into a full context (its own chat thread, tasks,
// artifacts, and log slice). Selecting one swaps the whole working context.
model Board {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  deadline  String?
  color     String? // accent for the workstream card
  summary   String? // one-line "what this stream is about"
  createdAt DateTime @default(now())

  tasks     Task[]
}

model Member {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  color      String
  role       String?
  admin      Boolean   @default(false) // workspace admin (creator, or promoted) — can change settings
  lastSeenAt DateTime? // last time this member opened their workspace (for "what's new" briefings)

  ownedTasks    Task[]         @relation("TaskOwner")
  notifications Notification[] @relation("Notify")
  logEntries    LogEntry[]
  updates    Update[]
  messages   Message[]
  conversations Conversation[]

  @@unique([projectId, userId]) // one membership per user per workspace
}

// A task, documented as a small spec (objective, acceptance criteria, priority…).
model Task {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boardId            String
  board              Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name               String
  // status: "new" | "inprogress" | "blocked" | "done"
  status             String   @default("inprogress")
  ownerId            String?
  owner              Member?  @relation("TaskOwner", fields: [ownerId], references: [id])
  note               String?
  objective          String? // why it matters / what "done" delivers
  acceptanceCriteria String? // JSON array of strings — the definition of done
  dependencies       String? // what it's blocked by / needs first
  priority           String? // "low" | "medium" | "high"
  due                String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// A work record: an official, structured document posted to the project timeline.
model Update {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String?
  author    Member?  @relation(fields: [authorId], references: [id])
  title     String
  status    String
  summary   String? // one-line headline
  details   String? // the substantive body of the record
  changes   String? // design / scope changes
  impact    String? // downstream effects, who/what is affected
  artifacts String? // JSON array of files / links
  nextSteps String?
  createdAt DateTime @default(now())
}

// A piece of shared knowledge the Connector surfaced.
model Knowledge {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag        String
  text       String
  importance String? // "normal" | "important" | "critical" — AI-evaluated significance
  createdAt  DateTime @default(now())
}

// A proposed change to a task owned by someone else — needs the owner's approval.
model ChangeRequest {
  id              String   @id @default(cuid())
  projectId       String
  taskId          String
  taskName        String // denormalized for display
  requestedById   String?
  requestedByName String?
  targetId        String? // the task owner who must approve
  proposedStatus  String
  note            String?
  status          String   @default("pending") // "pending" | "approved" | "declined"
  createdAt       DateTime @default(now())
}

// A timestamped entry in a member's activity log — the raw thing they recorded.
// The primary capture surface; the agent absorbs it silently.
model LogEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  boardId   String?
  text      String // the raw thing the user typed
  synced    String? // short note of what auto-applied, e.g. "Claw mechanism → done"
  createdAt DateTime @default(now())
}

// A "for you" delivery item — how captured information reaches the people who need it.
model Notification {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   Member   @relation("Notify", fields: [recipientId], references: [id], onDelete: Cascade)
  kind        String // "assignment" | "connector" | "share"
  text        String
  importance  String?
  fromName    String?
  boardName   String?
  taskName    String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// A full log of one agent turn (for debugging / inspectability). No relations, so it
// survives dev reseeds.
model AgentLog {
  id          String   @id @default(cuid())
  memberName  String?
  boardName   String?
  userMessage String
  toolCalls   String // JSON: [{ name, arguments }]
  reply       String
  createdAt   DateTime @default(now())
}

// A question hung on a workstream: directed at specific people or everyone, with a
// visibility rule and optional answer-conditioned actions. Answers are AI-mediated.
model Question {
  id           String   @id @default(cuid())
  projectId    String
  boardId      String?
  askerId      String
  text         String
  audience     String // "specific" | "everyone"
  visibility   String // "private" | "team"
  targetIds    String  @default("[]") // JSON array of member ids (empty for "everyone")
  answerType   String   @default("open") // "open" | "yesno"
  branchYes    String? // JSON BoardAction[] applied if answered "yes"
  branchNo     String? // JSON BoardAction[] applied if answered "no"
  status       String   @default("open") // "open" | "answered" | "resolved"
  answerRaw    String?
  answer       String? // AI-polished
  answererId   String?
  firedActions String? // JSON: labels of branch actions that ran
  createdAt    DateTime @default(now())
}

// A compacted slice of a member's conversation: the agent's short heading + brief
// summary, with the full transcript stored behind it. On later turns the agent
// scans these summaries and pulls back only the ones relevant to the new message.
model CompactEntry {
  id        String   @id @default(cuid())
  projectId String
  memberId  String
  heading   String
  summary   String
  content   String // the full compacted transcript (markdown)
  createdAt DateTime @default(now())
}

// A sync-feed item a member dismissed, so the ambient panel doesn't re-surface it.
model SyncDismissal {
  id        String   @id @default(cuid())
  memberId  String
  key       String
  createdAt DateTime @default(now())

  @@unique([memberId, key])
}

// A sync item Relay already spoke up about proactively, so it never repeats.
model ProactiveDelivery {
  id        String   @id @default(cuid())
  memberId  String
  key       String
  createdAt DateTime @default(now())

  @@unique([memberId, key])
}

// A possible-staleness the reconciliation tier flagged: your active task may now
// conflict with newer shared knowledge. Persisted so it lives in the feed until resolved.
model ReconcileFlag {
  id        String   @id @default(cuid())
  memberId  String
  taskName  String
  text      String // the AI's phrasing of the conflict
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([memberId, taskName])
}

// A named chat thread inside a member's private AI workspace, scoped to a workstream
// (board). Lets a member keep several conversations, switch between them, and rename.
model Conversation {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  boardId   String? // the workstream this thread belongs to
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([projectId, memberId])
}

// Per-member private AI workspace conversation.
model Message {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  boardId        String? // which workstream this chat belongs to (null = legacy/global)
  conversationId String? // which named thread this belongs to (null = legacy)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  feedback       Int? // thumbs: -1 down, 1 up, null none (assistant messages only)
  createdAt      DateTime      @default(now())
}
