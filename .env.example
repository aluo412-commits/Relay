# Copy to .env and fill in. Never commit the real .env.

# --- Database (Postgres) ---
# Local dev: point at a Neon dev branch or a local Postgres.
# Production (Vercel): set this in the Vercel dashboard to your Neon pooled URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# Session cookie signing key. Generate one with:  openssl rand -base64 32
AUTH_SECRET="generate-a-random-32+-char-string"

# --- LLM provider (OpenAI-compatible) ---
MINIMAX_API_KEY="your-minimax-key"
MINIMAX_BASE_URL="https://api.minimax.chat/v1"
MINIMAX_MODEL="MiniMax-M2"
