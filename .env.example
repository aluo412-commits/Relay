# Copy to .env and fill in. Never commit the real .env.

# --- Database (Postgres) ---
# Local dev: point at a Neon dev branch or a local Postgres.
# Production (Vercel): set this in the Vercel dashboard to your Neon pooled URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# Session cookie signing key. Generate one with:  openssl rand -base64 32
AUTH_SECRET="generate-a-random-32+-char-string"

# --- LLM provider (OpenAI-compatible; e.g. OpenCode Zen) — server-side only ---
OPENCODE_API_KEY="your-llm-provider-key"
LLM_BASE_URL="https://opencode.ai/zen/go/v1"
LLM_MODEL="deepseek-v4-flash"
