# Copy to .env and fill in. Never commit the real .env.

# --- Database (Postgres) ---
# Local dev: point at a Neon dev branch or a local Postgres.
# Production (Vercel): set this in the Vercel dashboard to your Neon pooled URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# Session cookie signing key. Generate one with:  openssl rand -base64 32
AUTH_SECRET="generate-a-random-32+-char-string"

# Google sign-in (optional — leave blank to hide the "Continue with Google" button).
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- LLM provider (OpenAI-compatible) — server-side only ---
# Default provider is Zhipu GLM (BigModel). Create a key at
# https://bigmodel.cn/usercenter/proj-mgmt/apikeys  (or https://z.ai for international).
LLM_API_KEY="your-zhipu-glm-key"
# Pick the base URL that matches your key:
#   BigModel Coding Plan key: https://open.bigmodel.cn/api/coding/paas/v4
#   BigModel pay-as-you-go:   https://open.bigmodel.cn/api/paas/v4
#   z.ai (international):      https://api.z.ai/api/paas/v4
LLM_BASE_URL="https://open.bigmodel.cn/api/coding/paas/v4"
LLM_MODEL="glm-5.3-flash"
